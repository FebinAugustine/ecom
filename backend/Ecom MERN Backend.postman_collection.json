{
	"info": {
		"_postman_id": "a8c1b2d3-e4f5-4a6b-8c7d-9e8f7a6b5c4d",
		"name": "Ecom MERN Backend - Stage Two",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register/user",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register", "user"]
						}
					}
				},
				{
					"name": "Register Seller",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testseller\",\n    \"email\": \"seller@example.com\",\n    \"password\": \"password123\",\n    \"companyName\": \"Test Corp\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register/seller",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register", "seller"]
						}
					}
				},
				{
					"name": "Verify Email",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/verify-email/:token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "verify-email", ":token"]
						}
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}",
							"options": {"raw": {"language": "json"}}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						}
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get All Products",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/products"}
				},
				{
					"name": "Get Product by ID",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/products/:id"}
				},
				{
					"name": "Create Product (Seller)",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "name", "value": "My Awesome Product"},
								{"key": "description", "value": "This is a great product."},
								{"key": "price", "value": "99.99"},
								{"key": "category", "value": "your_category_id"},
								{"key": "stock", "value": "100"},
								{"key": "images", "type": "file", "src": []}
							]
						},
						"url": "{{baseUrl}}/api/v1/products"
					}
				},
				{
					"name": "Update Product (Seller)",
					"request": {
						"method": "PUT",
						"body": {"mode": "raw", "raw": "{\n    \"name\": \"Updated Product Name\"\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/products/:id"
					}
				},
				{
					"name": "Delete Product (Seller)",
					"request": {"method": "DELETE", "url": "{{baseUrl}}/api/v1/products/:id"}
				}
			]
		},
		{
			"name": "Categories",
			"item": [
				{
					"name": "Get All Categories",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/categories"}
				},
				{
					"name": "Create Category (Admin/Seller)",
					"request": {
						"method": "POST",
						"body": {"mode": "raw", "raw": "{\n    \"name\": \"Electronics\",\n    \"description\": \"Gadgets and devices.\"\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/categories"
					}
				}
			]
		},
		{
			"name": "User Interactions",
			"item": [
				{
					"name": "Add/Update Review (User)",
					"request": {
						"method": "POST",
						"body": {"mode": "raw", "raw": "{\n    \"rating\": 5,\n    \"comment\": \"This product is amazing!\"\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/products/:id/reviews"
					}
				},
				{
					"name": "Toggle Like (User)",
					"request": {"method": "POST", "url": "{{baseUrl}}/api/v1/products/:id/like"}
				},
				{
					"name": "Toggle Wishlist (User)",
					"request": {
						"method": "POST",
						"body": {"mode": "raw", "raw": "{\n    \"productId\": \"your_product_id\"\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/users/wishlist"
					}
				},
				{
					"name": "Manage Cart (User)",
					"request": {
						"method": "POST",
						"body": {"mode": "raw", "raw": "{\n    \"productId\": \"your_product_id\",\n    \"quantity\": 1\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/users/cart"
					}
				},
				{
					"name": "View Cart (User)",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/users/cart"}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Create Order (User)",
					"request": {
						"method": "POST",
						"body": {"mode": "raw", "raw": "{\n    \"shippingAddress\": \"123 Main St, Anytown, USA\"\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/orders"
					}
				},
				{
					"name": "Get My Orders (User)",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/orders"}
				}
			]
		},
		{
			"name": "Seller Dashboard",
			"item": [
				{
					"name": "Get Seller Orders",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/seller/orders"}
				},
				{
					"name": "Update Order Status",
					"request": {
						"method": "PUT",
						"body": {"mode": "raw", "raw": "{\n    \"status\": \"Shipped\"\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/seller/orders/:id"
					}
				},
				{
					"name": "Get Seller Revenue",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/seller/revenue"}
				}
			]
		},
		{
			"name": "Admin Dashboard",
			"item": [
				{
					"name": "Get All Users",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/admin/users"}
				},
				{
					"name": "Update User Status",
					"request": {
						"method": "PUT",
						"body": {"mode": "raw", "raw": "{\n    \"isActive\": false\n}", "options": {"raw": {"language": "json"}}},
						"url": "{{baseUrl}}/api/v1/admin/users/:id/status"
					}
				},
				{
					"name": "Get All Orders",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/admin/orders"}
				},
				{
					"name": "Get Platform Revenue",
					"request": {"method": "GET", "url": "{{baseUrl}}/api/v1/admin/revenue"}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}
